# Local development only. Copy to .env and choose strong local passwords.
MYSQL_DATABASE=pamati
MYSQL_USER=pamati
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-different-root-password
# Local backend (Compose constructs its own URL). URL-encode password characters.
DATABASE_URL=mysql+pymysql://pamati:replace-with-local-password@localhost:3306/pamati?charset=utf8mb4
ENVIRONMENT=development
# Raw retention remains disabled unless both this flag and the database setting are enabled.
ALLOW_RAW_MEDIA_STORAGE=false
# Development account seed password is supplied interactively; no default credentials.
# DEV_SEED_PASSWORD=
# Optional, isolated real-MySQL tests: database name MUST end in _test.
# TEST_DATABASE_URL=mysql+pymysql://test_user:password@localhost:3306/pamati_test?charset=utf8mb4
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend","testserver"]
# Local frontend server only; Compose overrides this with http://backend:8000.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
